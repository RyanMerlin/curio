# PostgreSQL
POSTGRES_USER=curio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=curio
DATABASE_URL=postgresql+asyncpg://curio:change-me@postgres:5432/curio

# FalkorDB / Graphiti
# Graphiti MCP endpoint (internal Docker network: graphiti:8000, external: host:8001)
GRAPHITI_URL=http://graphiti:8000/mcp/

# OpenAI (for Codex agent sessions)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Curator subagent runtime (local-only)
CURATOR_LLM_BASE_URL=http://localhost:8000/v1
CF_TUNNEL_SA_CLIENT_ID_HEADER=CF-Access-Client-Id: your-client-id
CF_TUNNEL_SA_CLIENT_SECRET_HEADER=CF-Access-Client-Secret: your-client-secret
CURATOR_LLM_API_KEY=sk-your-curator-key
CURATOR_LLM_MODEL=qwen3.5-9b
CURATOR_LLM_REQUEST_TIMEOUT_SECONDS=120
CURIO_TEMP_DIR=
CURIO_CONFLUENCE_OUTPUT_ROOT_FOLDER_ID=

# Confluence Cloud
ATLASSIAN_EMAIL=you@example.com
CONFLUENCE_BASE_URL=https://yourorg.atlassian.net/wiki
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_CLIENT_MODE=auto
CONFLUENCE_BEARER_TOKEN_FILE=/path/to/token.json
CONFLUENCE_CLOUD_ID=your-cloud-id

# Curio harness config
CURIO_CONFLUENCE_URL=https://yourorg.atlassian.net/wiki
CURIO_CONFLUENCE_EMAIL=you@example.com
CURIO_CONFLUENCE_TOKEN=your-confluence-api-token
CURIO_SPACE_KEY=CURIO
# Optional fallback only if CURIO_CONFLUENCE_OUTPUT_ROOT_FOLDER_ID is unset
CURIO_ROOT_FOLDER_NAME=
CONFLUENCE_GOVERNED_SPACE_KEY=CURIO

# Jira Cloud
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_API_TOKEN=your-jira-api-token

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# CURIO API Keys — format: name:key:role,name2:key2:role2
# Roles: AGENT | ADMIN | REVIEWER
CURIO_API_KEYS=agent:your-agent-key:AGENT,admin:your-admin-key:ADMIN

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# Review App
REVIEW_APP_HOST=0.0.0.0
REVIEW_APP_PORT=3000
