# Curio harness config
CURIO_CONFLUENCE_URL=https://yourorg.atlassian.net/wiki
CURIO_CONFLUENCE_EMAIL=you@example.com
CURIO_CONFLUENCE_TOKEN=your-confluence-api-token
CURIO_SPACE_KEY=CURIO
# Defaults to the OS temp directory.
CURIO_TEMP_DIR=
CURIO_HTTP_TIMEOUT_SECONDS=45
# Defaults to <repo-root>/wiki
CURIO_WIKI_DIR=
