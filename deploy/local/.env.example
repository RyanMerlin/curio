# curio-service local dev secrets — copy to .env before running compose.
#
# Today: one Confluence bot token shared across all 3 KBs (single-tenant default).
# Tomorrow: replace each individual env var below with a per-KB token by
# editing this file — no code change needed.

# Single shared Confluence token (becomes CURIO_CONFLUENCE_TOKEN_* for each KB).
CURIO_CONFLUENCE_TOKEN=replace-me-with-confluence-api-token

# Optional: LLM key if you want to drive process/route locally.
# Leave empty to use the passthrough provider backend (default in compose).
OPENAI_API_KEY=
