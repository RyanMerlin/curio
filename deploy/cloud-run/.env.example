# Auth: none = no auth check (local/dev only); bearer = static token; iap = Google Cloud IAP
CURIO_SERVICE_AUTH_MODE=none

# LLM backend
CURIO_SERVICE_PROVIDER_BACKEND=gemini
CURIO_SERVICE_PROVIDER_MODEL=gemini-2.5-pro

# Gemini auth — choose ONE:
#   Option A (local dev): Gemini Developer API key from https://aistudio.google.com/apikey
#   Uses generativelanguage.googleapis.com — no GCP project or OAuth needed.
CURIO_GEMINI_API_KEY=

#   Option B (GCP / Cloud Run): Vertex AI project — service account provides OAuth automatically.
#   Leave CURIO_GEMINI_API_KEY blank and set these instead:
# CURIO_VERTEX_PROJECT_ID=your-project-id
# CURIO_VERTEX_LOCATION=us-central1

# State paths (mapped to /state volume in docker-compose)
CURIO_SERVICE_REGISTRY=/state/workspaces.json
CURIO_SERVICE_JOBS=/state/jobs.jsonl
CURIO_SERVICE_AUDIT=/state/audit.jsonl

# Git worktree cache (ephemeral)
CURIO_SERVICE_CACHE=/tmp/curio/cache

# Service
CURIO_SERVICE_BIND_ADDR=0.0.0.0:8080
CURIO_BINARY=/usr/local/bin/curio

# GitLab credentials (leave blank for read-only / local testing without a real repo)
CURIO_GITLAB_TOKEN=
CURIO_GITLAB_USERNAME=oauth2

# Bearer mode auth token (only used when CURIO_SERVICE_AUTH_MODE=bearer)
# CURIO_SERVICE_BEARER_TOKEN=

# IAP configuration (only used when CURIO_SERVICE_AUTH_MODE=iap)
# CURIO_IAP_AUDIENCE=/projects/<number>/global/backendServices/<id>
# CURIO_PUBSUB_SA_EMAIL=curio-control-plane@your-project.iam.gserviceaccount.com
# CURIO_SERVICE_URL=https://your-cloud-run-url

# Logging: trace, debug, info, warn, error
RUST_LOG=info
